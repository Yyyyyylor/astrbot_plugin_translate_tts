    "url_replacement":{"description":"URL 替换提示语"},
    "emoji_mode":{"description":"Emoji 处理","labels":["保留","转为名称","跳过"]},
    "table_mode":{"description":"表格处理","labels":["逐行朗读","摘要提示","跳过"]},
    "table_summary_text":{"description":"表格摘要提示语"},
    "quote_mode":{"description":"引用处理","labels":["保留","跳过"]},
    "collapse_whitespace":{"description":"折叠多余空白"},
    "max_preprocessed_chars":{"description":"最大预处理输出长度"},
    "emotion_continuity_enabled":{"description":"启用情感连续性"},
    "emotion_continuity_mode":{"description":"连续性模式","labels":["关闭","保守继承","允许转换","固定首段"]},
    "neutral_inherits":{"description":"neutral 分段继承当前情感"},
    "max_continuity_segments":{"description":"最大连续分段数"},
    "preview_text":{"description":"试听文本"},
    "preview_emotion":{"description":"试听情感","labels":["中性","开心","悲伤","愤怒","害怕","厌恶","惊讶","平静"]},
    "preview_translate":{"description":"试听前先翻译"},
    "preview_tts_provider_id":{"description":"试听 TTS provider"}
  },
