{
  "metadata": {
    "display_name": "翻译 TTS",
    "short_desc": "仅在原有 TTS 链路合成语音时翻译文本。",
    "desc": "保留原语言回答，并通过原链路选择的 TTS 提供商合成可配置目标语言的译文。"
  },
  "config": {
    "enabled": {
      "description": "启用 TTS 翻译"
    },
    "emotion_enabled": {
      "description": "启用基础情感控制",
      "hint": "关闭后仍保留翻译和 TTS 提供商选择。"
    },
    "tts_provider_id": {
      "description": "译文语音 TTS 提供商",
      "hint": "留空时按选择模式处理；显式 ID 无效时保持原上游链路。"
    },
    "tts_selection_mode": {
      "description": "TTS 选择模式",
      "labels": ["优先 Fish Audio", "沿用上游"]
    },
    "fish_model": {
      "description": "Fish Audio 模型",
      "hint": "每次 Fish 请求都会显式发送；不会回退到付费型号。",
      "labels": ["S2.1 Pro 免费版", "S2.1 Pro", "S2 Pro", "S1"]
    },
    "translation_provider_id": {
      "description": "翻译 LLM 提供商",
      "hint": "仅用于翻译，不会替换聊天提供商；留空时使用当前会话的聊天提供商。"
    },
    "target_language": {
      "description": "目标语言",
      "labels": ["日语", "英语", "韩语", "简体中文", "繁体中文", "法语", "德语", "西班牙语", "自定义"]
    },
    "custom_target_language": {
      "description": "自定义目标语言名称",
      "hint": "仅当目标语言选择“自定义”时必填。"
    },
    "translation_timeout_seconds": {
      "description": "翻译总超时（秒）",
      "hint": "包含等待并发名额的时间，范围为 1–120 秒。"
    },
    "max_input_chars": {
      "description": "原文最大字符数",
      "hint": "超过限制时跳过翻译，直接使用完整原文进行 TTS。"
    },
    "max_output_chars": {
      "description": "译文最大字符数",
      "hint": "超过限制的模型输出会被拒绝并回退到原文 TTS。"
    },
    "max_concurrent_translations": {
      "description": "最大并发翻译数",
      "hint": "限制本插件实例同时进行的翻译请求数。"
    },
    "enable_proactive_compat": {
      "description": "启用主动聊天兼容",
      "hint": "为 astrbot_plugin_proactive_chat v1.2.5 的 TTS 路径启用翻译。"
    },
    "custom_prompts_enabled":{"description":"启用自定义提示词"},
    "translation_prompt_mode":{"description":"翻译提示词模式","labels":["使用内置","追加到内置","完全替换"]},
    "translation_prompt_text":{"description":"自定义翻译提示词","hint":"{target_language}：解析后的目标语言；{emotion_options}：允许的基础情感枚举；{fish_cues}：Fish 情感标签白名单（非 Fish 模式为空）。需要输入字面量大括号时请写 {{ 或 }}；未知占位符会被拒绝。"},
    "emotion_prompt_mode":{"description":"情感提示词模式","labels":["使用内置","追加到内置","完全替换"]},
    "emotion_prompt_text":{"description":"自定义情感提示词","hint":"{target_language}：解析后的目标语言；{emotion_options}：允许的基础情感枚举；{fish_cues}：Fish 情感标签白名单（非 Fish 模式为空）。需要输入字面量大括号时请写 {{ 或 }}；未知占位符会被拒绝。"},
    "auto_cleanup_tts_files":{"description":"自动清理已登记的 TTS 文件"},
    "tts_file_retention_days":{"description":"文件保留天数","hint":"范围 1–365 天，默认 30 天。"},
    "cleanup_check_period":{"description":"清理检查周期","labels":["启动时","每 12 小时","每天","每周"]},
    "preprocessing_enabled":{"description":"启用文本预处理"},
    "code_block_mode":{"description":"代码块处理","labels":["保留","跳过","替换为提示语"]},
    "code_block_replacement":{"description":"代码块替换提示语"},
    "markdown_decoration_mode":{"description":"Markdown 装饰","labels":["保留","移除"]},
